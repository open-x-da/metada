{
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: Build",
            "command": "cmake --build ${workspaceFolder}/build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Copy WRF namelist.input",
            "command": "cp -f ${env:WRFDA_ROOT}/var/test/tutorial/namelist.input ${workspaceFolder}/build/namelist.input",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Copy WRF LANDUSE.TBL",
            "command": "cp -f ${env:WRFDA_ROOT}/run/LANDUSE.TBL ${workspaceFolder}/build/LANDUSE.TBL",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Copy WRF wrfinput_d01",
            "command": "cp -f ${env:WRFDA_ROOT}/var/test/tutorial/rc/2008020512/wrfinput_d01 ${workspaceFolder}/build/wrfinput_d01",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Copy WRF observation file",
            "command": "cp -f '${env:WRFDA_ROOT}/var/test/tutorial/ob/2008020512/obs_gts_2008-02-05_12:00:00.3DVAR' ${workspaceFolder}/build/ob.ascii",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Copy WRF BE statistics file",
            "command": "cp -f '${env:WRFDA_ROOT}/var/test/tutorial/be/be.dat' ${workspaceFolder}/build/be.dat",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Prepare WRF Runtime Environment",
            "dependsOn": [
                "Copy WRF namelist.input",
                "Copy WRF LANDUSE.TBL",
                "Copy WRF wrfinput_d01",
                "Copy WRF observation file",
                "Copy WRF BE statistics file"
            ],
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}